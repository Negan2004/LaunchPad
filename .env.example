# LaunchPad environment configuration - TEMPLATE ONLY.
#
# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored. Never commit real credentials, and never put real
# values in this file.
#
# Generate a fresh secret key with:
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- core ------------------------------------------------------------------

DJANGO_SECRET_KEY=replace-me-with-a-freshly-generated-50-character-secret
DJANGO_DEBUG=True

# Comma separated. Add production hostnames here; do not commit them.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma separated, scheme included, e.g. https://launchpad.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- database --------------------------------------------------------------

DB_NAME=launchpad_final_test
DB_USER=postgres
DB_PASSWORD=replace-me-with-your-local-postgres-password
DB_HOST=localhost
DB_PORT=5432

# --- paths (optional; sensible defaults are used when unset) ----------------

# DJANGO_STATIC_ROOT=
# DJANGO_MEDIA_ROOT=

# --- uploads (optional) ----------------------------------------------------

# DJANGO_FILE_UPLOAD_MAX_BYTES=10485760
# DJANGO_DATA_UPLOAD_MAX_BYTES=20971520

# --- email (optional) ------------------------------------------------------

# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=noreply@launchpad.example.com

# --- HTTPS / production only -----------------------------------------------
#
# SECURE_MODE follows DEBUG automatically. Override it only when you need
# DEBUG=False over plain HTTP (e.g. a staging box) - leaving it on there would
# set secure cookies and make login impossible without TLS.
#
# DJANGO_SECURE_MODE=True
#
# Set when a reverse proxy terminates TLS:
# DJANGO_TRUST_PROXY_SSL_HEADER=True
#
# HSTS cannot be undone before it expires. Confirm HTTPS works everywhere,
# then ramp: 3600 -> 86400 -> 31536000.
# DJANGO_HSTS_SECONDS=0
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False
